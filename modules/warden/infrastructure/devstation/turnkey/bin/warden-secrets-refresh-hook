#!/usr/bin/env bash
# warden-secrets-refresh-hook — runs (execute.command) each time the agent
# re-renders /run/warden-secrets/warden.env. Locks perms to root-only and
# touches a freshness marker consumers can stat. Never prints values.
set -euo pipefail
SECRETS_DIR="/run/warden-secrets"
[ -f "$SECRETS_DIR/warden.env" ] && chmod 0600 "$SECRETS_DIR/warden.env"
[ -f "$SECRETS_DIR/.infisical-token" ] && chmod 0600 "$SECRETS_DIR/.infisical-token"
: > "$SECRETS_DIR/.fresh"
echo "warden-secrets: rendered $(grep -c '=' "$SECRETS_DIR/warden.env" 2>/dev/null || echo 0) keys"

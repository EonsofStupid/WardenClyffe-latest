#!/usr/bin/env bash
# warden-secrets-preflight — runs as ExecStartPre for the Infisical Agent.
# Asserts the credential files exist before the broker starts, so a misinstall
# fails loudly instead of looping. Never prints secret values.
set -euo pipefail
for f in /etc/warden/infisical/client-id /etc/warden/infisical/client-secret \
         /etc/warden/agent-config.yaml /etc/warden/secrets.tmpl; do
  [ -s "$f" ] || { echo "preflight: missing or empty $f"; exit 1; }
done
echo "preflight: ok"

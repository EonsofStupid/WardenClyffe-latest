# Warden devstation machine identity (Infisical Universal Auth).
# Canonical location: /etc/warden/infisical-mi.env  (root-only, chmod 0600).
# Copy this template there and fill the values. NEVER commit the real secret.
#
# One-time operator gate (per decision 2026-06-06):
#   - allowlist the devstation egress IP (currently 104.176.44.101/32) in the
#     machine identity's Universal Auth "Trusted IPs"
#   - issue a LIVE client secret (Universal Auth client secrets expire / have a
#     max-uses cap — a 401 "Invalid credentials" means it rotated out)

INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=
# Only if you self-host Infisical (else the agent uses https://app.infisical.com):
# INFISICAL_API_URL=

{{/*
  Warden devstation secret template (Infisical Agent, listSecrets DSL).
  Renders every secret in the project/env to dotenv lines: KEY=value.
  __PROJECT_ID__ and __ENV__ are substituted from /etc/warden/infisical-mi.env
  by install-devstation-turnkey.sh — do not hardcode ids in the repo.
*/ -}}
{{- with listSecrets "__PROJECT_ID__" "__ENV__" "/" }}
{{- range . }}
{{ .Key }}={{ .Value }}
{{- end }}
{{- end }}
